{
  "name": "@chchco/cli",
  "version": "0.1.0",
  "description": "Compiles concept models into tested TypeScript",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chad3814/ccc.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "prompts"
  ],
