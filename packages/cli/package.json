    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "hono": "^4.13.9"
  }
}
